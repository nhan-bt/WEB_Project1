    {
      "rule_id": "BSR-PAYMENT-01",
      "name": "Payment Only for Confirmed Order",
      "category": "PAYMENT",
      "description": "Chỉ cho phép pay_order khi order.status là CONFIRMED.",
      "subject": "CUSTOMER_OR_OPERATOR",
      "resource": "ORDER_PAYMENT",
      "event": "PAY_ORDER",
      "preconditions": [
        {
          "field": "order.exists",
          "operator": "==",
          "value": true
        }
      ],
      "guard": [
        {
          "field": "order.status",
          "operator": "==",
          "value": "CONFIRMED"
        }
      ],
      "expected_result": {
        "accept": true,
        "payment_record_created": true
      },
      "violation_expected": {
        "accept": false,
        "http_status": 409,
        "payment_record_created": false,
