    {
      "id": "INV-02",
      "scope": "ORDER",
      "expression": "ordered_quantity <= stock_before",
      "kind": "state_predicate",
      "applies_in_states": [
        "CART",
        "PENDING_CONFIRMATION",
        "CONFIRMED",
        "PAID"
      ],
      "check": {
        "var": "ordered_quantity",
        "op": "<=",
        "value_var": "stock_before"
      },
      "description": "Không đặt hàng vượt tồn kho (stock_before là snapshot lúc tạo đơn; không áp dụng sau khi hủy).",
      "rule_refs": [
        "BSR-STOCK-01",
        "BSR-STOCK-03"
      ]
